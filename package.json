{
  "name": "@suifei/dsh-market-lens",
  "version": "0.34.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "寰镜股票看板 MarketLens — read-only A股/港股/美股看盘盯盘 stock board for the DSH Web GUI (delayed public quotes, no trading)",
  "keywords": [
    "股票看板",
    "股票", "看盘", "盯盘", "摸鱼", "股市", "A股", "港股", "美股",
    "stock", "stocks", "market", "quote", "dashboard", "huanjing", "marketlens"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suifei/dsh-market-lens.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/*": "./lib/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "lib/sources/*.js",
    "locale/*.json",
    "assets/*.woff2",
    "assets/*.bin",
    "assets/*.png",
    "screenshots.json",
    "icon.svg",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "overrides": {
    "zod": "^4.6.6"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.6.6"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
